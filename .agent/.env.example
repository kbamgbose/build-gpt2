# Runtime knobs for train.py
# All variables are optional — defaults shown here are the in-code fallbacks.

# Training length
MAX_STEPS=19073                # total optimizer steps (default: 19073 ≈ 1 epoch on FineWeb-10B)

# Checkpointing
CHECKPOINT_DIR=checkpoints     # directory to save .pt files
CHECKPOINT_INTERVAL=500        # save a checkpoint every N steps
MAX_CHECKPOINTS=5              # keep only the N most recent checkpoints

# Cost tracking (training_reliability.cost_tracker)
GPU_COST_PER_HR=2.50           # USD per GPU-hour; used for cost estimates in cost_report.json

# Distributed (set automatically by torchrun — do not set manually)
# RANK
# LOCAL_RANK
# WORLD_SIZE
